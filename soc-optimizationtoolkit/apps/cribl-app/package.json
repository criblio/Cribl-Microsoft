{
  "name": "soc-optimizationtoolkit",
  "private": true,
  "version": "1.12.3",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "check-release": "node scripts/check-release-drift.mjs",
    "check-docs": "node scripts/check-docs-drift.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "board": "node scripts/board.mjs",
    "groom": "node scripts/board-groom.mjs",
    "board:serve": "node scripts/board-serve.mjs",
    "check-board": "node scripts/board.mjs --check",
    "check-board-freshness": "node scripts/board-freshness.mjs"
  },
  "dependencies": {
    "@soc/core": "*",
    "@soc/ui": "*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "displayName": "soc-OptimizationToolKit",
  "author": "James Pederson",
  "cribl": {
    "type": "app",
    "createAppScriptVersion": "0.2.0"
  }
